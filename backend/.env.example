# Copia este archivo como .env (NO lo subas al repositorio) y ajusta los valores.
APP_ENV=development              # production desactiva /docs
DATA_PROVIDER=demo               # demo | csv | api_football (pendiente)
CSV_MATCHES_PATH=data/ejemplo_partidos.csv
# CSV_GOALS_PATH=data/goles.csv
DATABASE_URL=sqlite:///./datapro.db   # producción: postgresql+psycopg://usuario:clave@host:5432/datapro
CORS_ORIGINS=http://localhost:3000    # varios separados por coma
RATE_LIMIT_PER_MINUTE=120
WRITE_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=false
HISTORY_MAX_ROWS=1000
# --- Datos reales (DATA_PROVIDER=api_football) ---------------------------------
# La clave SOLO la usan los scripts de sincronización que corres en tu PC. Nunca la subas a Git.
# API_FOOTBALL_KEY=
# API_FOOTBALL_CACHE_DIR=data/cache/api_football
# IDs de liga por VERIFICAR con: python -m scripts.api_football_cobertura
# API_FOOTBALL_LEAGUES=239:liga_betplay,241:copa_colombia
