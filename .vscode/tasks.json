{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend: API (puerto 8000)", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Frontend: web (puerto 3000)", "type": "shell", "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Todo: API + web", "dependsOn": ["Backend: API (puerto 8000)", "Frontend: web (puerto 3000)"], "problemMatcher": [] },
    { "label": "Backend: pruebas", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" }, "group": "test", "problemMatcher": [] },
    { "label": "Frontend: tipos + build", "type": "shell", "command": "npx tsc --noEmit && npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "group": "build", "problemMatcher": [] },
    { "label": "Datos reales: prueba de cobertura", "type": "shell", "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m scripts.api_football_cobertura",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] }
  ]
}
